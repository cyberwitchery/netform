{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netform.local/schemas/fixture.schema.json",
  "title": "Netform Replay Fixture",
  "type": "object",
  "required": [
    "name",
    "intended",
    "actual",
    "normalization_steps",
    "order_policy",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "dialect": {
      "type": "string",
      "enum": ["generic", "eos", "fortios", "iosxe", "iosxr", "junos", "nxos"],
      "default": "generic"
    },
    "intended": { "type": "string" },
    "actual": { "type": "string" },
    "normalization_steps": { "$ref": "normalization-pipeline.schema.json" },
    "order_policy": { "$ref": "order-policy.schema.json" },
    "expected": {
      "type": "object",
      "required": ["has_changes", "edit_types", "finding_codes"],
      "additionalProperties": false,
      "properties": {
        "has_changes": { "type": "boolean" },
        "edit_types": {
          "type": "array",
          "items": { "type": "string", "enum": ["Insert", "Delete", "Replace"] }
        },
        "finding_codes": {
          "type": "array",
          "items": { "$ref": "diff.schema.json#/$defs/finding_code" }
        }
      }
    }
  }
}
